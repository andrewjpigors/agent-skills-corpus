{
  "corpus_name": "claude-agent-skills-corpus",
  "purpose": "Reproducible research corpus of public Claude/Agent Skills (SKILL.md) for systematic analysis.",
  "snapshot_date": "2026-07-18",
  "snapshot_timezone": "UTC",
  "inclusion_criteria": {
    "basename_exact": "SKILL.md",
    "requires_yaml_frontmatter": true,
    "frontmatter_required_fields": ["name", "description"],
    "frontmatter_fields_must_be_nonempty": true,
    "exclude_empty_files": true,
    "exclude_pure_template_placeholders": true,
    "note": "GitHub filename: qualifier is a fuzzy/substring match (returns e.g. xNeedSkiLL.md); every candidate is post-filtered to exact basename SKILL.md."
  },
  "exclusions": {
    "exclude_forks": true,
    "template_markers": [
      "your-skill-name", "your skill name", "TODO", "FIXME",
      "<name>", "<description>", "example-skill", "replace this",
      "brief description of", "one-line description", "lorem ipsum",
      "short description of what", "name-of-your-skill"
    ]
  },
  "dedup": {
    "method": "sha256 of raw SKILL.md bytes",
    "keep": "earliest source by (repo created_at, then commit/last_updated, then repo full_name)",
    "exclude_forks_before_dedup": true,
    "report_before_and_after": true
  },
  "sources": {
    "github_code_search": {
      "query": "filename:SKILL.md",
      "endpoint": "GET /search/code",
      "shard_by": "size range (bytes), adaptive recursive split when total_count>1000 or HTTP 422",
      "per_page": 100,
      "max_pages_per_shard": 10,
      "results_cap_per_query": 1000,
      "rate_limit": "10 requests/min (code_search)",
      "search_min_interval_seconds": 6.6,
      "size_seed_range": [0, 200000]
    },
    "anthropics_skills": {"repo": "anthropics/skills", "method": "recursive git tree"},
    "awesome_lists_and_marketplaces": "hand-enumerated; see raw/other_sources/",
    "gitlab": {"endpoint": "GET /api/v4/search?scope=blobs&search=filename:SKILL.md", "host": "gitlab.com"},
    "gitee": {"endpoint": "https://gitee.com/api/v5/search/... / web search", "note": "equivalent SKILL.md search"},
    "sourcegraph": {"endpoint": "https://sourcegraph.com/.api/search/stream", "purpose": "cross-validate GitHub coverage on a sample"}
  },
  "record_fields": [
    "platform", "repo", "owner", "owner_type", "path", "html_url",
    "stars", "license_spdx", "is_fork",
    "repo_created_at", "repo_pushed_at", "file_last_commit_at",
    "default_branch", "content_sha256", "skill_md_text",
    "sibling_files", "frontmatter_name", "frontmatter_description",
    "source", "snapshot_date"
  ],
  "budgets": {
    "github_search_calls": 900,
    "github_core_calls_soft": 12000,
    "note": "budgets are soft ceilings; pipeline is resumable across sessions"
  },
  "publishability": {
    "publish_full_text_if_license_in": ["MIT", "Apache-2.0", "BSD-2-Clause", "BSD-3-Clause", "MPL-2.0", "ISC", "Unlicense", "CC0-1.0", "0BSD", "CC-BY-4.0", "CC-BY-SA-4.0", "GPL-2.0", "GPL-3.0", "LGPL-2.1", "LGPL-3.0", "AGPL-3.0", "BSL-1.0", "Zlib", "EPL-2.0"],
    "otherwise": "metadata only in the published repo; full text kept in full_text_local_only/ for local analysis"
  }
}
